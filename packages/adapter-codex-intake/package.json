{
  "name": "@codeclosure/adapter-codex-intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run build && node ../../scripts/run-node-tests.mjs test/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codeclosure/codex-app-server-client": "workspace:*",
    "@codeclosure/runtime": "workspace:*"
  },
  "devDependencies": {}
}
