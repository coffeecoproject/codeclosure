{
  "name": "@codeclosure/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "test": "pnpm run test:unit",
    "test:digests": "pnpm run build && node ../../scripts/run-node-tests.mjs test/acceptance-engine.test.ts test/authority-codecs.test.ts test/context-compiler.test.ts test/deterministic-fixtures.test.ts test/evidence-authority.test.ts test/intake-domain.test.ts",
    "test:unit": "pnpm run build && node ../../scripts/run-node-tests.mjs test/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codeclosure/domain": "workspace:*",
    "@codeclosure/runtime": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  }
}
