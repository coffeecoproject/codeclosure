{
  "name": "@codeclosure/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codeclosure/domain": "workspace:*",
    "@codeclosure/runtime": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.9.0"
  }
}
